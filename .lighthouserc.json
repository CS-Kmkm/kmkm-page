{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/ja",
        "http://localhost:3000/ja/career",
        "http://localhost:3000/ja/dev-experience",
        "http://localhost:3000/ja/publications",
        "http://localhost:3000/en",
        "http://localhost:3000/en/career",
        "http://localhost:3000/en/dev-experience",
        "http://localhost:3000/en/publications"
      ],
      "startServerCommand": "corepack pnpm start",
      "startServerReadyPattern": "started server on|Local:|Ready in|started server",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.8}],
        "categories:accessibility": ["error", {"minScore": 0.9}],
        "categories:best-practices": ["warn", {"minScore": 0.8}],
        "categories:seo": ["error", {"minScore": 0.9}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
